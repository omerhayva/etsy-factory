# Copy this file to .env. Never commit real credentials.

# Etsy Open API v3: use a token with listings_r scope.
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_API_BASE_URL=https://openapi.etsy.com/v3/application

# Pinterest API v5. Start with Sandbox; change to https://api.pinterest.com/v5 only for live publishing.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_SCOPES=boards:read,pins:write
PINTEREST_API_BASE_URL=https://api-sandbox.pinterest.com/v5
PINTEREST_DEFAULT_BOARD_ID=

APP_DATABASE_PATH=database/etsy_pinterest.sqlite3
APP_TIMEZONE=Europe/Istanbul
WORKER_POLL_SECONDS=30
WORKER_STALE_MINUTES=20
OAUTH_TOKEN_STORE=.secrets/oauth_tokens.json
